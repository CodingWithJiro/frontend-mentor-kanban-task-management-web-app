# PostgreSQL connection string from your database provider
DATABASE_URL=

# Express.js server port number
PORT=

# Add your JWT secret for verifying tokens
JWT_SECRET=

# Add access token expiration time (e.g. 1h)
ACCESS_TOKEN_EXPIRES_IN=

# Add refresh token expiration time (e.g. 7d)
REFRESH_TOKEN_EXPIRES_IN=

# Add total number of salt rounds for password hashing (e.g. 12)
BCRYPT_SALT_ROUNDS=

# Next.js frontend API base URL (e.g. http://localhost:3001)
NEXT_PUBLIC_API_URL=