Table users {
  id int [pk, increment]
  name varchar [not null]
  email varchar [not null, unique]
  password_hash varchar [not null]
  avatar_url varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table boards {
  id int [pk, increment]
  name varchar [not null]
  position int [not null]
  user_id int [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (user_id, position) [unique]
  }
}

Ref: boards.user_id > users.id [delete: cascade]

Table columns {
  id int [pk, increment]
  name varchar [not null]
  color varchar [not null]
  position int [not null]
  board_id int [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (board_id, position) [unique]
  }
}

Ref: columns.board_id > boards.id [delete: cascade]

Table tasks {
  id int [pk, increment]
  title varchar [not null]
  description text 
  position int [not null]
  column_id int [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (column_id, position) [unique]
  }
}

Ref: tasks.column_id > columns.id [delete: cascade]

Table subtasks {
  id int [pk, increment]
  title varchar [not null]
  is_completed boolean [not null]
  position int [not null]
  task_id int [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (task_id, position) [unique]
  }
}

Ref: subtasks.task_id > tasks.id [delete: cascade]